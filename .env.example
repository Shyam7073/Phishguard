# Free key from https://auth.abuse.ch — enables the URLhaus blocklist lookup.
# Without it, /scan degrades to ML + domain age and reports urlhaus_status="unknown".
URLHAUS_AUTH_KEY=

# Neon (or any Postgres) connection string, e.g.:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Leave unset for local dev to fall back to a local SQLite file.
DATABASE_URL=

# Comma-separated hostnames to trust automatically, skipping the ML/URLhaus/
# RDAP checks entirely (e.g. PhishGuard's own deployed dashboard, which
# otherwise looks lexically like a phishing URL on free hosting -- see
# MODEL_REPORT.md). "localhost" and "127.0.0.1" are always trusted.
# Example: TRUSTED_HOSTS=phishguard.pages.dev
TRUSTED_HOSTS=
